{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "DAVYLAB Content Studio / Editorial Identity",
  "version": "1.0.0",
  "colors": {
    "navy": {
      "$type": "color",
      "$value": "#142B40"
    },
    "ink": {
      "$type": "color",
      "$value": "#18344C"
    },
    "action": {
      "$type": "color",
      "$value": "#2D78D7"
    },
    "actionHover": {
      "$type": "color",
      "$value": "#195FAF"
    },
    "paper": {
      "$type": "color",
      "$value": "#F7F9FB"
    },
    "cloud": {
      "$type": "color",
      "$value": "#EAF3FC"
    },
    "line": {
      "$type": "color",
      "$value": "#DCE6ED"
    },
    "muted": {
      "$type": "color",
      "$value": "#657E92"
    }
  },
  "radius": {
    "card": {
      "$type": "dimension",
      "$value": "12px"
    },
    "logoTile": {
      "$type": "dimension",
      "$value": "29px"
    }
  },
  "logo": {
    "master": "./davylab-studio-mark.svg",
    "lockup": "./davylab-studio-lockup.svg",
    "lightCanvasSymbol": "./davylab-studio-symbol.svg",
    "clearSpace": "Minimum 25% of emblem width on all sides",
    "minimumWidth": "24px for icon; 140px for horizontal lockup"
  },
  "principles": [
    "Three input lines = discovery, research and editorial materials",
    "Blue diamond = human judgement/AI assist with human review",
    "Forward chevron = moving a verified idea toward production",
    "Flat color, optical alignment, no decorative gradient"
  ]
}
